     " ", "slopes", " ", "using", " ", "zero"}], "-", 
    RowBox[{"field", " ", "region", " ", "relations"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "5.", " ", "Propagate", " ", "to", " ", "the", " ", "ID", " ", "exit", 
     " ", "using", " ", 
