Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Integrate", " ", "ideal", " ", "on"}], "-", 
    RowBox[{"energy", " ", "orbit", " ", 
     RowBox[{"(", "NDSolve", ")"}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"delta", " ", "=", " ", "0.0"}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{"initial", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.0", ",", " ", "0.0", ",", " ", "0.0", ",", " ", "0.0"}], 
      "}"}]}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{"initial", " ", "=", " ", 
     RowBox[{"initial", " ", "+", " ", 
      RowBox[{"1.0", "*", 
       RowBox[{"{", 
        RowBox[{"0.0", ",", " ", "cxi", ",", " ", "0.0", ",", " ", "czi"}], 
        "}"}]}]}]}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "positions", ",", " ", "xs", ",", " ", "xps", ",", " ", "zs", ",", " ", 
       "zps"}], "}"}], " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"RadFldPtcTrj", "[", 
       RowBox[{"magnet", ",", " ", 
        RowBox[{"energy", "*", 
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", "delta"}], ")"}]}], ",", " ", "initial",
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"ymin", ",", " ", "ymax"}], "}"}], ",", " ", "ypts", ",", 
        " ", 
        RowBox[{"Method", " ", "\[Rule]", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<FixedStep\>\"", ",", " ", 
           RowBox[{"Method", " ", "\[Rule]", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<StiffnessSwitching\>\"", ",", " ", 
              RowBox[{"Method", " ", "\[Rule]", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", " ", "Automatic"}],
                 "}"}]}]}], "}"}]}]}], "}"}]}]}], "]"}], "]"}]}], " ", ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"pltx", " ", "=", " ", 
