  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"In", " ", "general"}], ",", " ", 
    RowBox[{
    "a", " ", "zero", " ", "initial", " ", "condition", " ", "at", " ", "the",
      " ", "min", " ", "longitudinal", " ", "position", " ", "will", " ", 
     "not", " ", "be", " ", "mapped", " ", "to", " ", "zero", " ", "at", " ", 
     "the", " ", "max", " ", "longitudinal", " ", "position"}]}], " ", "*)"}],
   "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "This", " ", "is", " ", "due", " ", "to", " ", "the", " ", "mean", " ", 
    "orbit", " ", "not", " ", "aligning", " ", "with", " ", "the", " ", 
    "field", " ", "symmetry", " ", "axes"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "A", " ", "correction", " ", "to", " ", "enforce", " ", "a", " ", 
     "zero"}], "-", "to", "-", 
    RowBox[{
    "zero", " ", "mapping", " ", "can", " ", "be", " ", "computed", " ", "by",
      " ", "solving", " ", "a", " ", "fixed", " ", "point", " ", 
     "problem"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"These", " ", "corrections", " ", 
