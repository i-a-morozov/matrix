Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{" ", "Elleaume", "\[CloseCurlyQuote]"}], "s", " ", "potential", 
    " ", "can", " ", "be", " ", "used", " ", "to", " ", "compute", " ", "the",
     " ", "linear", " ", "focusing", " ", "parameters", " ", "kx", " ", "and",
     " ", "kz", " ", 
    RowBox[{"(", 
