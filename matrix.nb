5fb6b28b8196"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Orbit", "-", 
    RowBox[{"matching", " ", "corrections"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"In", " ", "general"}], ",", " ", 
    RowBox[{
    "a", " ", "zero", " ", "initial", " ", "condition", " ", "at", " ", "the",
      " ", "minimum", " ", "longitudinal", " ", "position", " ", "will", " ", 
     "not", " ", "be", " ", "mapped", " ", "to", " ", "zero", " ", "at", " ", 
     "the", " ", "maximum", " ", "longitudinal", " ", "position"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "This", " ", "is", " ", "due", " ", "to", " ", "the", " ", "mean", " ", 
    "orbit", " ", "not", " ", "aligning", " ", "with", " ", "the", " ", 
    "field", " ", "symmetry", " ", "axes"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "A", " ", "correction", " ", "to", " ", "enforce", " ", "a", " ", 
     "zero"}], "-", "to", "-", 
    RowBox[{
    "zero", " ", "mapping", " ", "can", " ", "be", " ", "computed", " ", "by",
      " ", "solving", " ", "a", " ", "fixed"}], "-", 
    RowBox[{"point", " ", "problem"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"These", " ", "corrections", " ", 
    RowBox[{"(", 
     RowBox[{"and", " ", "the", " ", "resulting", " ", "mismatch"}], ")"}], 
    " ", "are", " ", "normally", " ", "very", " ", "small", " ", "and", " ", 
    "can", " ", "be", " ", "neglected", " ", 
