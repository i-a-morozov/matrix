            RowBox[{"\"\<Delta\>\"", " ", "\[Rule]", " ", "True"}]}], "]"}], 
          " ", "/@", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"+", "epsilon"}], "*", 
            RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ")"}]}]}], " ", ";", 
        "\n", "\t", 
        RowBox[{"negative", " ", "=", " ", 
         RowBox[{
          RowBox[{"km", "[", 
           RowBox[{"map", ",", " ", "delta", ",", " ", "np", ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "1"}], "}"}], ",", " ", 
