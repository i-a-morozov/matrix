           "magnet", ",", " ", "energy", ",", " ", "delta", ",", " ", 
            RowBox[{"{", 
             RowBox[{"lp", ",", " ", "lp"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "2", ",", " ", "3", ",", " ", "4"}], 
