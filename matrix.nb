   3.972524152256529*^9, 3.972524159276956*^9}, {3.972524661089263*^9, 
   3.9725246627138567`*^9}, {3.974426544260291*^9, 3.974426547298285*^9}, 
   3.9890258792879553`*^9},ExpressionUUID->"2440029f-b497-41f4-9203-\
34e7a42f6466"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Given", " ", "the", " ", "magnetic", " ", "field"}], ",", " ", 
    RowBox[{"one", " ", "can", " ", "compute", " ", 
     RowBox[{"Elleaume", "'"}], "s", " ", "potential", " ", "for", " ", "one",
      " ", "ID", " ", "period"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "This", " ", "potential", " ", "is", " ", "used", " ", "to", " ", 
    "compute", " ", "the", " ", "transverse", " ", "momentum", " ", "kicks"}],
    " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "integral", " ", "for", " ", "the", " ", "potential", " ", 
    "is", " ", "approximated", " ", "by", " ", "a", " ", "truncated", " ", 
    "Fourier", " ", "representation", " ", "of", " ", "the", " ", "periodic", 
    " ", "magnetic", " ", "field"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "For", " ", "a", " ", "fixed", " ", "transverse", " ", "position"}], ",", 
    " ", 
    RowBox[{
    "one", " ", "or", " ", "more", " ", "harmonics", " ", "of", " ", "the", 
     " ", "field", " ", "components", " ", "are", " ", "computed", " ", 
     "over", " ", "one", " ", "period", " ", "from", " ", "numerical", " ", 
     "field", " ", "samples"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"The", " ", "one"}], "-", 
    RowBox[{
    "period", " ", "potential", " ", "is", " ", "then", " ", "approximated", 
     " ", "from", " ", "the", " ", "amplitudes", " ", "of", " ", "these", " ",
      "harmonics"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "This", " ", "is", " ", "the", " ", "default", " ", "method", " ", "used", 
    " ", "to", " ", "compute", " ", "potential", " ", "values"}], " ", 
   "*)"}]}]], "Code",
 CellChangeTimes->{{3.989025939038546*^9, 3.989026003072744*^9}, {
   3.989026041324403*^9, 3.989026089557994*^9}, {3.989026315468419*^9, 
