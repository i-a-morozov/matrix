Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "To", " ", "account", " ", "for", " ", "chromatic", " ", "effects"}], ",",
     " ", 
    RowBox[{
     RowBox[{
     "the", " ", "transport", " ", "matrix", " ", "can", " ", "be", " ", 
      "factorized", " ", "as", " ", "M", 
      RowBox[{"(", "\[Delta]", ")"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"exp", 
       RowBox[{"(", 
        RowBox[{"S", " ", "A"}], ")"}], " ", "exp", 
       RowBox[{"(", 
        RowBox[{"\[Delta]", " ", "S", " ", "B"}], ")"}], " ", "exp", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Delta]", "^", "2"}], " ", "S", " ", "C"}], ")"}]}], " ", 
      "..."}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "analytical", " ", "construction", " ", "can", " ", "be", " ", 
    "derived", " ", "using", " ", "the", " ", "Magnus", " ", "expansion"}], 
   " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Leading", "-", 
     RowBox[{
     "order", " ", "effects", " ", "are", " ", "captured", " ", "by", " ", 
      "the", " ", "B", " ", "matrix"}]}], ",", " ", 
    RowBox[{
    "which", " ", "is", " ", "symmetric", " ", "and", " ", "in", " ", 
     "general", " ", "it", " ", "has", " ", "10", " ", "independent", " ", 
     "elements"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Expanding", " ", "in", " ", "a", " ", "series", " ", "M", 
     RowBox[{"(", "\[Delta]", ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"M", 
        RowBox[{"(", "0", ")"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"dM", "/", "d\[Delta]"}], ")"}], 
        RowBox[{"(", "0", ")"}], " ", "\[Delta]"}], " ", "+"}], " ", "..."}], 
     " ", "=", " ", 
     RowBox[{"M", 
      RowBox[{"(", "0", ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"I", " ", "+", " ", 
         RowBox[{"\[Delta]", " ", "S", " ", "B"}], " ", "+"}], " ", "..."}], 
       " ", ")"}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Matching", " ", "the", " ", "terms", " ", "gives", " ", "B"}], 
    " ", "=", " ", 
    RowBox[{
     RowBox[{"-", " ", "S"}], " ", "exp", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "S"}], " ", "A"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"dM", "/", "d\[Delta]"}], ")"}], 
     RowBox[{"(", "0", ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"The", " ", "derivative", " ", 
     RowBox[{"(", 
      RowBox[{"dM", "/", "d\[Delta]"}], ")"}], 
     RowBox[{"(", "0", ")"}], " ", "can", " ", "be", " ", "computed", " ", 
     "by", " ", "tracking", " ", "via", " ", "a", " ", "central", " ", 
     "finite", " ", "difference", " ", 
     RowBox[{"(", 
      RowBox[{"dM", "/", "d\[Delta]"}], ")"}], 
     RowBox[{"(", "0", ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"M", 
        RowBox[{"(", 
         RowBox[{"+", "\[CapitalDelta]"}], ")"}]}], " ", "-", " ", 
       RowBox[{"M", 
        RowBox[{"(", 
         RowBox[{"-", "\[CapitalDelta]"}], ")"}]}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", " ", "\[CapitalDelta]"}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "B", " ", "matrix", " ", "should", " ", "be", " ", "close", 
    " ", "to", " ", "symmetric"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"B", " ", "=", " ", 
    RowBox[{
     RowBox[{"1", "/", "2"}], " ", 
     RowBox[{"(", 
      RowBox[{"B", " ", "+", " ", 
       RowBox[{"Transpose", "[", "B", "]"}]}], ")"}], " ", "enforces", " ", 
     "symmetry"}]}], " ", "*)"}]}]], "Code",
