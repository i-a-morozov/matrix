     " ", "slopes", " ", "using", " ", "zero"}], "-", "field", "-", 
    RowBox[{"region", " ", "relations"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "5.", " ", "Propagate", " ", "to", " ", "the", " ", "ID", " ", "exit", 
