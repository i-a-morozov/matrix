Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Integrate", " ", "ideal", " ", "on"}], "-", 
    RowBox[{"energy", " ", "orbit", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"NDSolve", " ", "&"}], " ", "canonical", " ", "tracking"}], 
      ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", "  ", 
   RowBox[{"Note", ",", " ", 
    RowBox[{
    "external", " ", "fields", " ", "are", " ", "assumed", " ", "to", " ", 
     "be", " ", "normalized"}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"extAx", ",", " ", "extAy", ",", " ", "extAz"}], "]"}], " ", 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"extAx", "[", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], " ", ":=", " ", 
     "0.0"}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"extAy", "[", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], " ", ":=", " ", 
     "0.0"}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"extAz", "[", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], " ", ":=", " ", 
     "0.0"}], " ", ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"delta", " ", "=", " ", "0.0"}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{"initial", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"0.0", ",", " ", "0.0", ",", " ", "0.0", ",", " ", "0.0"}], 
      "}"}]}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{"initial", " ", "=", " ", 
     RowBox[{"initial", " ", "+", " ", 
      RowBox[{"1.0", "*", 
       RowBox[{"{", 
        RowBox[{"0.0", ",", " ", "cxi", ",", " ", "0.0", ",", " ", "czi"}], 
        "}"}]}]}]}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "positions", ",", " ", "qxs", ",", " ", "pxs", ",", " ", "qzs", ",", 
       " ", "pzs"}], "}"}], " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"RadFldPtcTrjCnn", "[", 
       RowBox[{
       "magnet", ",", " ", "energy", ",", " ", "delta", ",", " ", "initial", 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"ymin", ",", " ", "ymax"}], "}"}], ",", " ", "ypts", ",", 
        " ", 
        RowBox[{"{", 
