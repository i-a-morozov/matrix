Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Plot", " ", "potential", " ", "level", " ", "set"}], " ", "*)"}], 
  "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"xmin", ",", " ", "xmax"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "15.0"}], ",", " ", 
       RowBox[{"+", "15.0"}]}], "}"}]}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"zmin", ",", " ", "zmax"}], "}"}], " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "4.0"}], ",", " ", 
       RowBox[{"+", "4.0"}]}], "}"}]}], " ", ";"}], "\n", "\n", 
   RowBox[{"ContourPlot", "[", "\n", "\t", 
    RowBox[{
     RowBox[{"potential", "[", 
      RowBox[{"magnet", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"lp", ",", " ", "lp"}], "}"}], ",", " ", 
       RowBox[{"{", "1", "}"}], ",", " ", "0.0", ",", " ", 
       RowBox[{"\"\<SamplesPerHarmonic\>\"", " ", "->", " ", "32"}]}], "]"}], 
     ",", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "xmin", ",", " ", "xmax"}], "}"}], ",", " ", 
     "\n", "\t", 
     RowBox[{"{", 
      RowBox[{"y", ",", " ", "zmin", ",", " ", "zmax"}], "}"}], ",", " ", 
     "\n", "\t", 
     RowBox[{"AspectRatio", " ", "\[Rule]", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"zmax", " ", "-", " ", "zmin"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"xmax", " ", "-", " ", "xmin"}], ")"}]}]}], ",", " ", "\n", 
     "\t", 
     RowBox[{"PlotPoints", " ", "\[Rule]", " ", "100"}], ",", " ", "\n", "\t", 
     RowBox[{"ImageSize", " ", "\[Rule]", " ", "600"}], ",", " ", "\n", "\t", 
     
     RowBox[{"Contours", " ", "\[Rule]", " ", "10"}]}], "\n", 
    "]"}]}]}]], "Code",
