Cell[CellGroupData[{

Cell["Tracking (Elleaume\[CloseCurlyQuote]s potential)", "Section",
 CellChangeTimes->{{3.9723571921993437`*^9, 3.972357198239243*^9}, {
  3.972357302310534*^9, 3.972357311801402*^9}, {3.972357680601838*^9, 
  3.972357683774658*^9}, {3.9786854505952806`*^9, 3.978685453779807*^9}, {
  3.9786907085213223`*^9, 3.978690732501069*^9}, {3.978690770745887*^9, 
  3.978690784811331*^9}},ExpressionUUID->"4f5425fc-e56c-42b6-9779-\
a850e1b61a7c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "DKD", " ", "function", " ", "can", " ", "be", " ", "used", 
    " ", "to", " ", "perform", " ", "canonical", " ", "tracking", " ", 
    "using", " ", 
    RowBox[{"Elleaume", "'"}], "s", " ", "potential"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Similarly", " ", "to", " ", "RK"}], "-", 
     RowBox[{"based", " ", "tracking"}]}], ",", " ", 
    RowBox[{
    "canonical", " ", "coordinates", " ", "are", " ", "used", " ", "and", " ",
      "the", " ", "element", " ", "is", " ", "represented", " ", "as", " ", 
     "a", " ", "thin", " ", "nonlinear", " ", "insertion"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Each", " ", "ID", " ", "period", " ", "is", " ", "a", " ", "drift"}], 
     "-", "kick", "-", 
     RowBox[{"drift", " ", "sequence"}]}], ",", " ", 
    RowBox[{
    "where", " ", "the", " ", "kick", " ", "angles", " ", "are", " ", 
     "computed", " ", "from", " ", 
     RowBox[{"Elleaume", "'"}], "s", " ", "potential"}]}], " ", "*)"}], "\n", 
  
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Unlike", " ", "kick", " ", "maps"}], ",", " ", 
    RowBox[{
    "the", " ", "kick", " ", "angles", " ", "are", " ", "not", " ", 
     "precomputed", " ", "on", " ", "a", " ", "grid"}], ",", " ", 
    RowBox[{
    "but", " ", "are", " ", "computed", " ", "on", " ", "demand", " ", 
     "given", " ", "the", " ", "transverse", " ", "coordinates"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"In", " ", "all", " ", "computations"}], ",", " ", 
    RowBox[{
    "the", " ", "first", " ", "four", " ", "harmonics", " ", "are", " ", 
     "used"}], ",", " ", 
    RowBox[{
    "with", " ", "the", " ", "number", " ", "of", " ", "samples", " ", 
     "equal", " ", "to", " ", "32", " ", "x", " ", "harmonic", " ", 
     "number"}]}], " ", "*)"}]}]], "Code",
 CellChangeTimes->{{3.978709325113618*^9, 3.9787096182313137`*^9}, {
  3.978709648574051*^9, 3.978709799353867*^9}, {3.978746727112005*^9, 
  3.978746765025442*^9}, {3.9787468900494823`*^9, 3.978746938748043*^9}, {
  3.989033413653603*^9, 3.989033418318635*^9}},
 CellLabel->
  "In[594]:=",ExpressionUUID->"c30732b3-9a43-40fb-b71c-ce984cf2172f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Set", " ", "the", " ", "on"}], "-", 
    RowBox[{
    "orbit", " ", "canonical", " ", "initial", " ", "condition", " ", "for", 
     " ", "the", " ", "tracking", " ", "comparison"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "This", " ", "canonical", " ", "initial", " ", "condition", " ", 
    "corresponds", " ", "to", " ", "the", " ", "ID", " ", "center"}], " ", 
   "*)"}], " ", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Coordinates", " ", "are", " ", "in", " ", "meters"}], " ", "*)"}],
   "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"delta", " ", "=", " ", "0.0"}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{"initial", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.25", ",", " ", "0.0", ",", " ", "0.25", ",", " ", "0.0"}], 
       "}"}], "*", 
      RowBox[{"10.0", "^", 
       RowBox[{"-", "3"}]}]}]}], " ", ";"}]}]}]], "Code",
 CellChangeTimes->{{3.9726968648070173`*^9, 3.972696865508774*^9}, {
