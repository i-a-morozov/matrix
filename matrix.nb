Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Given", " ", "a", " ", "black"}], "-", 
     RowBox[{
     "box", " ", "thin", " ", "nonlinear", " ", "insertion", " ", 
      "mapping"}]}], ",", " ", 
    RowBox[{
    "the", " ", "corresponding", " ", "transport", " ", "matrix", " ", "can", 
     " ", "be", " ", "extracted", " ", "by", " ", "tracking", " ", "several", 
     " ", "initial", " ", "conditions", " ", "close", " ", "to", " ", "the", 
     " ", "origin"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "resulting", " ", "matrix", " ", "is", " ", "not", " ", 
     "symplectic"}], ",", " ", 
    RowBox[{
    "but", " ", "it", " ", "is", " ", "expected", " ", "to", " ", "be", " ", 
     "close", " ", "to", " ", "a", " ", "symplectic", " ", "one"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "A", " ", "standard", " ", "symplectification", " ", "procedure", " ", 
    "can", " ", "then", " ", "be", " ", "applied", " ", "to", " ", "obtain", 
    " ", "a", " ", "symplectic", " ", "matrix", " ", "that", " ", "can", " ", 
    "be", " ", "used", " ", "to", " ", "model", " ", "the", " ", 
    RowBox[{"ID", "'"}], "s", " ", "effect", " ", "on", " ", "linear", " ", 
    "optics"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "exponential", " ", "representation", " ", "can", " ", "be", 
     " ", "computed", " ", "from", " ", "this", " ", "matrix"}], ",", " ", 
    RowBox[{
     RowBox[{"yielding", " ", "a", " ", "redundancy"}], "-", 
     RowBox[{
     "free", " ", "representation", " ", "and", " ", "providing", " ", "a", 
      " ", "link", " ", "to", " ", "the", " ", "time"}], "-", 
     RowBox[{
     "one", " ", "Hamiltonian", " ", "and", " ", "monomials", " ", "with", 
      " ", "dominant", " ", "coefficients"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Alternatively", ",", " ", 
    RowBox[{
    "one", " ", "can", " ", "proceed", " ", "without", " ", 
     "symplectification", " ", "to", " ", "compute", " ", "the", " ", 
     "exponent", " ", "and", " ", "then", " ", "perform", " ", 
     "symmetrization"}]}], " ", "*)"}]}]], "Code",
