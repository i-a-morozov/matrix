Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Potential", " ", "tracking", " ", 
    RowBox[{"(", 
     RowBox[{
     "single", " ", "kick", " ", "at", " ", "the", " ", "ID", " ", "center"}],
      ")"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Here", ",", " ", 
    RowBox[{
    "the", " ", "dxp", " ", "and", " ", "dzp", " ", "angles", " ", "are", " ",
      "computed", " ", "explicitly", " ", "for", " ", "one", " ", "ID", " ", 
     "period", " ", "and", " ", "multiplied", " ", "by", " ", "the", " ", 
     "number", " ", "of", " ", "periods"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Input", " ", "coordinates", " ", "are", " ", "in", " ", "mm"}], 
    ",", " ", 
    RowBox[{
    "and", " ", "the", " ", "output", " ", "angles", " ", "are", " ", "in", 
     " ", "microradians"}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"qx", ",", " ", "px", ",", " ", "qz", ",", " ", "pz"}], "}"}], 
     " ", "=", " ", "initial"}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "xp", ",", " ", "z", ",", " ", "zp"}], "}"}], 
     " ", "=", " ", 
     RowBox[{"{", 
