Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Compare", " ", "potential", " ", "values", " ", "for", " ", "different", 
    " ", "number", " ", "of", " ", "harmonics", " ", "used"}], " ", "*)"}], 
  "\n", "\n", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"potential", "[", 
      RowBox[{"magnet", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1.0", ",", " ", "1.0"}], "}"}], ",", " ", 
       RowBox[{"{", 
