        " ", 
        RowBox[{"Method", " ", "\[Rule]", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<FixedStep\>\"", ",", " ", 
           RowBox[{"Method", " ", "\[Rule]", " ", 
            RowBox[{"{", 
             RowBox[{"\"\<StiffnessSwitching\>\"", ",", " ", 
              RowBox[{"Method", " ", "\[Rule]", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", " ", "Automatic"}],
                 "}"}]}]}], "}"}]}]}], "}"}]}]}], "]"}], "]"}]}], " ", ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"pltx", " ", "=", " ", 
     RowBox[{"ListPlot", "[", 
