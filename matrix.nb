Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "To", " ", "account", " ", "for", " ", "chromatic", " ", "effects"}], ",",
     " ", 
    RowBox[{
     RowBox[{
     "the", " ", "transport", " ", "matrix", " ", "can", " ", "be", " ", 
      "factorized", " ", "as", " ", "M", 
      RowBox[{"(", "\[Delta]", ")"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"exp", 
       RowBox[{"(", 
        RowBox[{"S", " ", "A"}], ")"}], " ", "exp", 
       RowBox[{"(", 
        RowBox[{"\[Delta]", " ", "S", " ", "B"}], ")"}], " ", "exp", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Delta]", "^", "2"}], " ", "S", " ", "C"}], ")"}]}], " ", 
      "..."}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "analytical", " ", "construction", " ", "can", " ", "be", " ", 
    "derived", " ", "using", " ", "the", " ", "Magnus", " ", "expansion"}], 
   " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Leading", "-", 
     RowBox[{
     "order", " ", "effects", " ", "are", " ", "captured", " ", "by", " ", 
      "the", " ", "B", " ", "matrix"}]}], ",", " ", 
    RowBox[{"which", " ", "is", " ", "symmetric", " ", "and"}], ",", " ", 
    RowBox[{"in", " ", "general"}], ",", " ", 
    RowBox[{"has", " ", "10", " ", "independent", " ", "elements"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Expanding", " ", "in", " ", "a", " ", "series", " ", "M", 
     RowBox[{"(", "\[Delta]", ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"M", 
        RowBox[{"(", "0", ")"}]}], " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"dM", "/", "d\[Delta]"}], ")"}], 
        RowBox[{"(", "0", ")"}], " ", "\[Delta]"}], " ", "+"}], " ", "..."}], 
     " ", "=", " ", 
     RowBox[{"M", 
      RowBox[{"(", "0", ")"}], " ", 
      RowBox[{"(", 
