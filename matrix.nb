Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "It", " ", "can", " ", "also", " ", "be", " ", "used", " ", "in", " ", 
    "WM", " ", "for", " ", "tracking", " ", 
    RowBox[{"(", 
     RowBox[{"comparison", " ", "of", " ", "nonlinear", " ", "effects"}], 
     ")"}], " ", "and", " ", "visualization"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "following", " ", "constructs", " ", "interpolated", " ", 
    "tables", " ", "from", " ", "the", " ", "given", " ", "kick", " ", 
    "map"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "kicks", " ", "are", " ", "for", " ", "one", " ", "ID", " ", 
     "period", " ", "and", " ", "are", " ", "not", " ", "normalized", " ", 
     "by", " ", "energy"}], ",", " ", 
    RowBox[{
    "and", " ", "the", " ", "sizes", " ", "are", " ", "in", " ", "meters"}]}],
    " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"interpolate", "[", "map", "]"}]}], " ", ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"{", "\n", "\t", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"data", "[", "\"\<XKick\>\"", "]"}], "[", 
          RowBox[{"x", ",", " ", "y"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", 
           RowBox[{"xmin", "*", 
            RowBox[{"10", "^", 
             RowBox[{"-", "3"}]}]}], ",", " ", 
           RowBox[{"xmax", "*", 
            RowBox[{"10", "^", 
             RowBox[{"-", "3"}]}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"y", ",", " ", 
           RowBox[{"zmin", "*", 
            RowBox[{"10", "^", 
             RowBox[{"-", "3"}]}]}], ",", " ", 
           RowBox[{"zmax", "*", 
            RowBox[{"10", "^", 
             RowBox[{"-", "3"}]}]}]}], "}"}], ",", " ", 
         RowBox[{"AspectRatio", " ", "\[Rule]", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"zmax", " ", "-", " ", "zmin"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"xmax", " ", "-", " ", "xmin"}], ")"}]}]}], ",", " ", 
         RowBox[{"PlotPoints", " ", "\[Rule]", " ", "100"}], ",", " ", 
         RowBox[{"ImageSize", " ", "\[Rule]", " ", "600"}], ",", " ", 
         RowBox[{"Contours", " ", "\[Rule]", " ", "10"}]}], "]"}], "}"}], ",",
       "\n", "\t", 
      RowBox[{"{", 
       RowBox[{"ContourPlot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"data", "[", "\"\<YKick\>\"", "]"}], "[", 
          RowBox[{"x", ",", " ", "y"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", 
           RowBox[{"xmin", "*", 
            RowBox[{"10", "^", 
             RowBox[{"-", "3"}]}]}], ",", " ", 
           RowBox[{"xmax", "*", 
            RowBox[{"10", "^", 
             RowBox[{"-", "3"}]}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"y", ",", " ", 
           RowBox[{"zmin", "*", 
            RowBox[{"10", "^", 
             RowBox[{"-", "3"}]}]}], ",", " ", 
           RowBox[{"zmax", "*", 
            RowBox[{"10", "^", 
             RowBox[{"-", "3"}]}]}]}], "}"}], ",", " ", 
         RowBox[{"AspectRatio", " ", "\[Rule]", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"zmax", " ", "-", " ", "zmin"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"xmax", " ", "-", " ", "xmin"}], ")"}]}]}], ",", " ", 
         RowBox[{"PlotPoints", " ", "\[Rule]", " ", "100"}], ",", " ", 
         RowBox[{"ImageSize", " ", "\[Rule]", " ", "600"}], ",", " ", 
         RowBox[{"Contours", " ", "\[Rule]", " ", "10"}]}], "]"}], "}"}]}], 
     "\n", "}"}], " ", "//", " ", "Grid"}]}]}]], "Code",
