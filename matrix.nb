  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "mkm", "]"}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"mkm", "[", 
      RowBox[{"delta_", ",", " ", "epsilon_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Block", "[", "\n", "\t", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"positive", ",", " ", "negative"}], "}"}], ",", "\n", "\t", 
       RowBox[{
        RowBox[{"positive", " ", "=", " ", 
