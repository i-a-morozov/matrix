            RowBox[{"-", "epsilon"}], "*", 
            RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ")"}]}]}], " ", ";", 
        "\n", "\t", 
        RowBox[{"symplectify", "[", 
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{"(", 
