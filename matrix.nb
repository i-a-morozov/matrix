Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"For", " ", "some", " ", "reason"}], ",", " ", 
    RowBox[{"canonical", " ", "tracking", " ", "matches", " ", 
     RowBox[{"Radia", "'"}], "s", " ", "RK", " ", "results", " ", "much", " ",
      "better"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"The", " ", "integration", " ", "method", " ", "used"}], ",", " ", 
    RowBox[{"or", " ", "the", " ", "step", " ", "size"}], ",", " ", 
    RowBox[{
    "does", " ", "not", " ", "seem", " ", "to", " ", "resolve", " ", "the", 
     " ", "discrepancy", " ", "when", " ", "using", " ", "RadFldPtcTrj", " ", 
     
     RowBox[{"(", 
      RowBox[{"slope", "-", 
       RowBox[{"based", " ", "solver"}]}], ")"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{" ", 
      RowBox[{
      "If", " ", "you", " ", "know", " ", "the", " ", "reason", " ", "why", 
       " ", "RadFldPtcTrj", " ", "does", " ", "not", " ", "match", " ", 
       "Radia"}], "\[CloseCurlyQuote]"}], "s", " ", "RK", " ", "well"}], ",", 
    " ", 
    RowBox[{"send", " ", "me", " ", "an", " ", 
     RowBox[{"email", ".", " ", 
      RowBox[{"Cheers", "!"}]}]}]}], " ", "*)"}]}]], "Code",
