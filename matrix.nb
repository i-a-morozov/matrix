Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "The", " ", "ID", " ", "is", " ", "modeled", " ", "as", " ", "a", " ", 
    "thin", " ", "nonlinear", " ", "insertion", " ", "using", " ", "the", " ",
     "following", " ", 
    RowBox[{"steps", ":"}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "1.", " ", "Given", " ", "an", " ", "initial", " ", "condition", " ", "in",
