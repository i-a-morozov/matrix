Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Compute", " ", "final", " ", "value", " ", "with", " ", "radFldPtcTrj", 
    " ", "solver"}], " ", "*)"}], "\n", "\n", 
  RowBox[{"final", " ", "=", " ", 
   RowBox[{
    RowBox[{"transport", "[", 
     RowBox[{"magnet", ",", " ", "energy", ",", " ", "delta", ",", " ", 
      RowBox[{"{", 
       RowBox[{"ymin", ",", " ", "ymax"}], "}"}], ",", " ", "ypts", ",", " ", 
