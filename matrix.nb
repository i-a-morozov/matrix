       RowBox[{"Range", "[", "n", "]"}], ",", " ", "0.0", ",", " ", 
       RowBox[{"\"\<SamplesPerHarmonic\>\"", " ", "->", " ", "32"}]}], "]"}], 
     ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "1", ",", " ", "5", ",", " ", "1"}], "}"}]}], 
