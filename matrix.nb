      RowBox[{"\"\<Thin\>\"", " ", "\[Rule]", " ", "True"}]}], "]"}], "[", 
    "initial", "]"}]}]}]], "Code",
 CellChangeTimes->{{3.971330011118105*^9, 3.971330038387514*^9}, 
