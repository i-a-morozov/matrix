Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Define", " ", "parametric", " ", "transport", " ", "matrix", " ", 
    RowBox[{"(", 
     RowBox[{"single", " ", "kick"}], ")"}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "m1k", "]"}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"m1k", "[", 
      RowBox[{"delta_", ",", " ", "epsilon_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Block", "[", "\n", "\t", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"positive", ",", " ", "negative"}], "}"}], ",", "\n", "\t", 
       RowBox[{
        RowBox[{"positive", " ", "=", " ", 
         RowBox[{
          RowBox[{"dkd", "[", 
           RowBox[{
           "magnet", ",", " ", "energy", ",", " ", "delta", ",", " ", 
