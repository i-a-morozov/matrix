     RowBox[{"and", " ", "the", " ", "resulting", " ", "mismatch"}], ")"}], 
    " ", "are", " ", "normally", " ", "very", " ", "small", " ", "and", " ", 
    "can", " ", "be", " ", "neglected", " ", 
