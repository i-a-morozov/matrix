           "]"}], " ", "/@", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"+", "epsilon"}], "*", 
            RowBox[{"IdentityMatrix", "[", "4", "]"}]}], ")"}]}]}], " ", ";", 
        "\n", "\t", 
        RowBox[{"negative", " ", "=", " ", 
         RowBox[{
          RowBox[{"dkd", "[", 
