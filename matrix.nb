Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Plot", " ", "3", "D", " ", "trajectory", " ", 
    RowBox[{"(", "magnified", ")"}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"bx", ",", " ", "by", ",", " ", "bz"}], "]"}], " ", ";"}], " ", 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bx", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"y_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"z_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"radFld", "[", 
      RowBox[{"magnet", ",", " ", "\"\<bx\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}]}], " ", 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"by", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"y_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"z_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"radFld", "[", 
      RowBox[{"magnet", ",", " ", "\"\<by\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}]}], " ", 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"bz", "[", 
      RowBox[{
       RowBox[{"x_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"y_", "?", "NumericQ"}], ",", " ", 
       RowBox[{"z_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"radFld", "[", 
      RowBox[{"magnet", ",", " ", "\"\<bz\>\"", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "}"}]}], "]"}]}], " ", 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "b", "]"}], " ", ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"b", "[", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "]"}], " ", ":=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"bx", "[", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ",", " ", 
       RowBox[{"by", "[", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ",", " ", 
       RowBox[{"bz", "[", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}]}], "}"}]}], " ", 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"field", " ", "=", " ", 
     RowBox[{"VectorPlot3D", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"b", "[", 
        RowBox[{"x", ",", " ", "y", ",", " ", "z"}], "]"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{
          RowBox[{"-", "0.75"}], "*", "lx"}], ",", " ", 
         RowBox[{
          RowBox[{"+", "0.75"}], "*", "lx"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"y", ",", " ", 
         RowBox[{
          RowBox[{"-", "lp"}], "/", "2"}], ",", " ", 
         RowBox[{
          RowBox[{"+", "lp"}], "/", "2"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"z", ",", " ", 
         RowBox[{
          RowBox[{"-", "1.5"}], "*", "lz"}], ",", " ", 
         RowBox[{
          RowBox[{"+", "1.5"}], "*", "lz"}]}], "}"}], ",", "\n", "  ", 
       RowBox[{"VectorPoints", " ", "\[Rule]", " ", 
        RowBox[{"{", 
         RowBox[{"16", ",", " ", "32", ",", " ", "8"}], "}"}]}], ",", "\n", 
       "  ", 
       RowBox[{"Lighting", " ", "\[Rule]", " ", "\"\<Neutral\>\""}], ",", 
       "\n", "  ", 
       RowBox[{"VectorScale", " ", "\[Rule]", " ", 
        RowBox[{"{", 
         RowBox[{"Small", ",", " ", "0.25", ",", " ", "None"}], "}"}]}], ",", 
       "\n", "  ", 
       RowBox[{"VectorStyle", " ", "\[Rule]", " ", 
        RowBox[{"Directive", "[", 
         RowBox[{"{", 
          RowBox[{"Opacity", "[", "0.50", "]"}], "}"}], "]"}]}], ",", "\n", 
       "  ", 
       RowBox[{"VectorColorFunction", " ", "\[Rule]", " ", "Hue"}], ",", "\n",
        "  ", 
       RowBox[{"ColorFunctionScaling", " ", "\[Rule]", " ", "True"}]}], "\n", 
      "]"}]}], " ", ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"factor", " ", "=", " ", "250.0"}], " ", ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"graphics", " ", "=", " ", 
     RowBox[{"Show", "[", "\n", "\t", 
      RowBox[{
       RowBox[{"Graphics3D", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"EdgeForm", "[", "None", "]"}], ",", " ", "LightBlue", ",",
            " ", 
           RowBox[{"Opacity", "[", "0.25", "]"}], ",", " ", 
           RowBox[{"radObjDrw", "[", "magnet", "]"}]}], "}"}], ",", " ", 
         RowBox[{"PlotRange", " ", "\[Rule]", " ", 
          RowBox[{"{", 
           RowBox[{"All", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "lp"}], "/", "2"}], ",", " ", 
              RowBox[{
               RowBox[{"+", "lp"}], "/", "2"}]}], "}"}], ",", " ", "All"}], 
           "}"}]}], ",", " ", 
         RowBox[{"ImageSize", " ", "\[Rule]", " ", "1000"}]}], "]"}], ",", 
       " ", "\n", "\t", 
       RowBox[{"ListPointPlot3D", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"factor", "*", "xs"}], ",", " ", "positions", ",", " ", 
           RowBox[{"factor", "*", "zs"}]}], "}"}], "]"}], "]"}], ",", "\n", 
